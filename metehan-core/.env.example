# OpenAI
OPENAI_API_KEY=
KUTALP_MODEL=gpt-5.6-terra
KUTALP_REALTIME_MODEL=gpt-realtime-2.1
KUTALP_VOICE=marin

# Local storage
KUTALP_DB=kutalp_prime.db
KUTALP_USER_ID=local-owner

# Server. Keep 127.0.0.1 when running on the same phone/PC.
# Use 0.0.0.0 only when you intentionally want LAN access.
KUTALP_HOST=127.0.0.1
KUTALP_PORT=8765

# Optional local access lock. Strongly recommended if KUTALP_HOST=0.0.0.0
KUTALP_ACCESS_TOKEN=
