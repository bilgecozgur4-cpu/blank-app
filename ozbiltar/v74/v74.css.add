/* V7.4 — USERS / ATTACHMENTS / QR / HERD / CLOUD */
.permission-hidden{display:none!important}.v74-security{margin-top:14px}.user-row,.role-row,.herd-row{border:1px solid var(--line);border-radius:12px;background:#fff;padding:12px;display:flex;align-items:center;justify-content:space-between;gap:10px}.user-row.selected{border-color:#c6a371;background:#fffaf2}.role-row small{display:block;color:var(--muted);margin-top:3px}.role-row>div:last-child{font-size:10px;color:var(--muted);text-align:right}.attachment-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.attachment-card{border:1px solid var(--line);border-radius:13px;background:#fff;overflow:hidden;display:grid;grid-template-columns:82px 1fr;min-height:88px}.attachment-thumb{background:var(--surface-soft);display:grid;place-items:center;overflow:hidden}.attachment-thumb img{width:100%;height:100%;object-fit:cover}.doc-icon{font-weight:900;color:var(--bronze)}.attachment-copy{padding:10px;min-width:0}.attachment-copy strong,.attachment-copy small,.attachment-copy em{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.attachment-copy strong{color:var(--navy)}.attachment-copy small,.attachment-copy em{color:var(--muted);font-size:10px;margin-top:3px}.attachment-copy em{font-style:normal}.attachment-actions{grid-column:1/-1;display:flex;gap:6px;padding:7px;border-top:1px solid var(--line)}.attachment-actions .action-btn{flex:1;text-align:center;text-decoration:none}.qr-card{text-align:center}.qr-image-wrap{min-height:290px;display:grid;place-items:center}.qr-image-wrap img{width:min(290px,90%);height:auto;image-rendering:pixelated}.qr-image-wrap small{display:block;font-size:9px;color:var(--muted);word-break:break-all;margin-top:6px}.qr-actions{display:flex;gap:8px}.qr-actions button{flex:1}.qr-animal-summary{margin-top:12px}.herd-row{display:block}.score-badge{display:inline-flex;align-items:center;border-radius:999px;padding:5px 9px;font-size:10px;font-weight:900;background:var(--surface-soft)}.score-badge.green{background:var(--green-soft);color:var(--green)}.score-badge.blue{background:var(--blue-soft);color:#395c84}.score-badge.red{background:var(--red-soft);color:var(--red)}.score-badge.amber{background:var(--amber-soft);color:var(--amber)}.herd-metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin:9px 0}.herd-metrics>div{background:var(--surface-soft);border-radius:9px;padding:8px}.herd-metrics span,.herd-metrics b{display:block}.herd-metrics span{font-size:9px;color:var(--muted)}.herd-metrics b{font-size:12px;color:var(--navy);margin-top:2px}.cloud-status-box{border:1px solid var(--line);border-radius:12px;padding:12px;background:var(--surface-soft);margin-bottom:10px}.cloud-status-box strong,.cloud-status-box span,.cloud-status-box small{display:block}.cloud-status-box span{color:var(--bronze);font-size:11px;margin-top:5px;word-break:break-all}.cloud-status-box small{color:var(--muted);font-size:10px;margin-top:5px}.cloud-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px}.cloud-actions button:last-child{grid-column:1/-1}.toggle-row{display:flex;align-items:center;gap:8px;border:1px solid var(--line);border-radius:10px;padding:10px}.v74-centers-panel{margin-bottom:14px}
@media(max-width:900px){.attachment-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:650px){.attachment-grid{grid-template-columns:1fr}.attachment-card{grid-template-columns:72px 1fr}.herd-metrics{grid-template-columns:1fr 1fr}.user-row,.role-row{align-items:flex-start;flex-direction:column}.role-row>div:last-child{text-align:left}.cloud-actions{grid-template-columns:1fr}.cloud-actions button:last-child{grid-column:auto}#usersView .head-actions{width:100%}#usersView .head-actions button{flex:1}}